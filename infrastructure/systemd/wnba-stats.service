[Unit]
Description=Ingest yesterday's final WNBA box scores
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wnba/repo
EnvironmentFile=/opt/wnba/repo/.env
ExecStart=/bin/bash -lc '/opt/wnba/repo/.venv/bin/wnba stats ingest-date "$(TZ=America/New_York date -d yesterday +%%F)"'
TimeoutStartSec=30m
Nice=5
