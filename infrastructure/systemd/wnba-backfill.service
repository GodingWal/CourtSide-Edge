[Unit]
Description=One-time canonical WNBA historical backfill
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wnba/repo
EnvironmentFile=/opt/wnba/repo/.env
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.local/bin/uv run wnba stats backfill --start 2024-05-01 --end 2026-08-02
TimeoutStartSec=30m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

