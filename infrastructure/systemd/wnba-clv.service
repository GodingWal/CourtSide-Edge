[Unit]
Description=Archive player-prop quotes and game odds every pass
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wnba/repo
EnvironmentFile=/opt/wnba/repo/.env
# Two record-only jobs on one timer: player-prop quotes, and the ESPN game spreads/totals a
# blowout refit needs. The quote poll runs every pass now -- a projection frozen on a
# mid-afternoon quote went stale inside two hours, and the research auditor (correctly)
# refused to run on it; near-lock-only polling was saving requests on a free endpoint at the
# cost of blocking research all afternoon. The odds snapshot stays chained with ';'.
ExecStart=/bin/bash -lc '/opt/wnba/repo/.venv/bin/wnba lines poll --quiet; /opt/wnba/repo/.venv/bin/wnba stats snapshot-odds --quiet'
TimeoutStartSec=10m
Nice=9
