[Unit]
Description=Refresh shrunk WNBA teammate-absence effects
After=wnba-roles.service docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wnba/repo
EnvironmentFile=/opt/wnba/repo/.env
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.local/bin/uv run wnba effects run
TimeoutStartSec=15m
Nice=5
