[Unit]
Description=Refresh WNBA player role and minutes distributions
After=wnba-injuries.service docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wnba/repo
EnvironmentFile=/opt/wnba/repo/.env
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.local/bin/uv run wnba roles run
TimeoutStartSec=10m
Nice=5
