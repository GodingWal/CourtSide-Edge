# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- PostgreSQL (operational store) ---------------------------------------
# Direct connection string used by migrations, workers and the API.
WNBA_DATABASE_URL=

# --- Private analyst ------------------------------------------------------
# Store a generated password hash, never a plaintext password.
WNBA_OWNER_USERNAME=
WNBA_OWNER_PASSWORD_HASH=
WNBA_SESSION_SECRET=

# --- Evidence-grounded research ------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
# Congestion and transport faults are retried; a rejected response never is.
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_BACKOFF_SECONDS=2.0

# --- Local analytics lake --------------------------------------------------
WNBA_LAKE_DIR=./data/lake
WNBA_DUCKDB_PATH=./data/wnba.duckdb

# --- Ingestion politeness --------------------------------------------------
# Minimum seconds between requests to any single free source. Do not lower.
WNBA_MIN_POLL_INTERVAL_SECONDS=60
WNBA_HTTP_USER_AGENT=wnba-prop-intelligence/0.1 (personal research)
WNBA_HTTP_TIMEOUT_SECONDS=20

# --- Risk policy -----------------------------------------------------------
# Analysis-only. The platform never places wagers; bankroll is for sizing math.
WNBA_BANKROLL_UNITS=1000
WNBA_KELLY_MULTIPLIER=0.10
WNBA_MAX_STAKE_FRACTION_PER_POSITION=0.005
WNBA_MAX_EXPOSURE_FRACTION_PER_GAME=0.02
WNBA_MAX_EXPOSURE_FRACTION_PER_DAY=0.05

# --- Recommendation gates --------------------------------------------------
WNBA_MIN_DATA_QUALITY_SCORE=0.90
WNBA_MAX_QUOTE_AGE_SECONDS=120
